APP_ENV=local

# Default host port 5433 so it does not clash with another local Postgres on 5432. Map: -p 5433:5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/hotel_agent

# Telephony — Linq Partner API (https://docs.linqapp.com/)
TELEPHONY_PROVIDER=linq
LINQ_API_KEY=
# Partner API root only (do NOT add /chats)
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
# E.164 number assigned in Linq (outbound sender / caller ID for messages & voice)
LINQ_FROM_NUMBER=
# Signing secret from Linq webhook subscription (verify X-Webhook-Signature). Optional for local-only testing.
LINQ_WEBHOOK_SECRET=
# LINQ_OUTBOUND_CHUNK_CHARS=1200
# LINQ_OUTBOUND_CHUNK_DELAY_S=0.35

# Hotel search: stub = seeded fake names only (no Maps API).
# google = Places Text Search + geocoding; requires GOOGLE_MAPS_API_KEY (Places API enabled, billing on).
HOTEL_DISCOVERY_PROVIDER=stub
GOOGLE_MAPS_API_KEY=
HOTEL_SEARCH_RADIUS_MILES=10
HOTEL_SEARCH_MAX_RESULTS=4

INTENT_PARSER_PROVIDER=llm

# Booking.com Partner Programme — optional affiliate id appended as aid= on generated search URLs
BOOKING_COM_AFFILIATE_ID=

CALLER_ID_MODE=verified_business_number

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.local_storage

LLM_PROVIDER=
LLM_API_KEY=
ASR_PROVIDER=
ASR_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

HF_TOKEN=
HF_INFERENCE_PROVIDER=fal-ai
HF_TTS_MODEL=hexgrad/Kokoro-82M
HF_ASR_MODEL=openai/whisper-large-v3

DEEPGRAM_API_KEY=
DEEPGRAM_LISTEN_MODEL=nova-2

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b

AUDIO_RETENTION_DAYS=7
TRANSCRIPT_RETENTION_DAYS=30
